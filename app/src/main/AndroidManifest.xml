<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 方法 J：全黑覆蓋層 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 方法 H / I：改休眠逾時與亮度 -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" tools:ignore="ProtectedPermissions" />
    <!-- 方法 C：反射 goToSleep（一般 App 拿不到，宣告了才有機會在系統簽章環境生效） -->
    <uses-permission android:name="android.permission.DEVICE_POWER" tools:ignore="ProtectedPermissions" />
    <!-- 元件掃描頁在 Android 11+ 需要 -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:allowBackup="true"
        android:icon="@android:drawable/ic_lock_idle_lock"
        android:label="@string/app_name"
        android:theme="@style/Theme.ScreenGuard">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".DevActivity"
            android:exported="false"
            android:label="開發者設定" />

        <activity
            android:name=".DiscoverActivity"
            android:exported="false"
            android:label="元件掃描" />

        <!-- 偵測音量／操作，同時提供方法 A 的 GLOBAL_ACTION_LOCK_SCREEN -->
        <service
            android:name=".ScreenGuardService"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- 通知欄開關的兩顆按鈕 -->
        <receiver
            android:name=".ToggleReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.car.screenguard.action.ENABLE" />
                <action android:name="com.car.screenguard.action.DISABLE" />
            </intent-filter>
        </receiver>

        <!-- 方法 B：裝置管理員 DevicePolicyManager.lockNow() -->
        <receiver
            android:name=".AdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
